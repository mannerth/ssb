2025-11-26 23:02:30,089 - src.workflow - INFO - workflow.py:148 - 采纳SQL: WITH station_info AS (
    SELECT stn_id, heat_area, stn_name 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE heat_area > 0
),
monthly_periods AS (
    SELECT 
        stn_id,
        DATE_FORMAT(data_time, '%Y-%m') AS month,
        MIN(data_time) AS month_start_time,
        MAX(data_time) AS month_end_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data
    WHERE data_time >= '2024-11-15 00:00:00' 
        AND data_time < '2025-03-15 00:00:00'
    GROUP BY stn_id, DATE_FORMAT(data_time, '%Y-%m')
),
start_elec AS (
    SELECT 
        d.stn_id,
        DATE_FORMAT(d.data_time, '%Y-%m') AS month,
        d.stn_total_elec AS start_elec
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN monthly_periods p ON d.stn_id = p.stn_id AND d.data_time = p.month_start_time
),
end_elec AS (
    SELECT 
        d.stn_id,
        DATE_FORMAT(d.data_time, '%Y-%m') AS month,
        d.stn_total_elec AS end_elec
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN monthly_periods p ON d.stn_id = p.stn_id AND d.data_time = p.month_end_time
),
electricity_consumption AS (
    SELECT 
        s.stn_id,
        s.month,
        i.stn_name,
        (e.end_elec - s.start_elec) * 24 * 120 / i.heat_area / 
        (TIMESTAMPDIFF(HOUR, p.month_start_time, p.month_end_time) + 1) AS monthly_electricity_consumption
    FROM start_elec s
    JOIN end_elec e ON s.stn_id = e.stn_id AND s.month = e.month
    JOIN monthly_periods p ON s.stn_id = p.stn_id AND s.month = p.month
    JOIN station_info i ON s.stn_id = i.stn_id
    WHERE e.end_elec > s.start_elec
),
ranked_stations AS (
    SELECT 
        stn_id,
        stn_name,
        month,
        monthly_electricity_consumption,
        ROW_NUMBER() OVER (PARTITION BY month ORDER BY monthly_electricity_consumption DESC) AS rank_num
    FROM electricity_consumption
)
SELECT 
    stn_id,
    stn_name,
    month,
    monthly_electricity_consumption
FROM ranked_stations
WHERE rank_num <= 5
ORDER BY month, rank_num;
