2025-11-23 22:52:41,796 - src.workflow - INFO - workflow.py:125 - 采纳SQL: SELECT stn_id, heat_area, plan_num 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE stn_name LIKE '%豪门又一城%'
),
monthly_ranges AS (
    SELECT 
        DATE_FORMAT(data_time, '%Y-%m') AS month_period,
        MIN(data_time) AS month_start,
        MAX(data_time) AS month_end
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00'
    AND stn_id = (SELECT stn_id FROM station_info)
    GROUP BY DATE_FORMAT(data_time, '%Y-%m')
),
start_values AS (
    SELECT 
        m.month_period,
        d.stn_id,
        d.stn1_seco_repl_total_flow AS start_water1,
        d.stn2_seco_repl_total_flow AS start_water2,
        d.stn3_seco_repl_total_flow AS start_water3
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN monthly_ranges m ON d.stn_id = (SELECT stn_id FROM station_info) 
        AND d.data_time = m.month_start
),
end_values AS (
    SELECT 
        m.month_period,
        d.stn_id,
        d.stn1_seco_repl_total_flow AS end_water1,
        d.stn2_seco_repl_total_flow AS end_water2,
        d.stn3_seco_repl_total_flow AS end_water3
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN monthly_ranges m ON d.stn_id = (SELECT stn_id FROM station_info) 
        AND d.data_time = m.month_end
)
SELECT 
    s.month_period,
    ((COALESCE(e.end_water1, 0) - COALESCE(s.start_water1, 0)) * 
     CASE WHEN (SELECT plan_num FROM station_info) >= 1 THEN 1 ELSE 0 END +
     (COALESCE(e.end_water2, 0) - COALESCE(s.start_water2, 0)) * 
     CASE WHEN (SELECT plan_num FROM station_info) >= 2 THEN 1 ELSE 0 END +
     (COALESCE(e.end_water3, 0) - COALESCE(s.start_water3, 0)) * 
     CASE WHEN (SELECT plan_num FROM station_info) >= 3 THEN 1 ELSE 0 END) * 
    1000 * 120 * 24 / 
    (SELECT heat_area FROM station_info) / 
    (TIMESTAMPDIFF(HOUR, m.month_start, m.month_end) + 1) AS water_specific_consumption
FROM start_values s
JOIN end_values e ON s.month_period = e.month_period
JOIN monthly_ranges m ON s.month_period = m.month_period
ORDER BY s.month_period;
