),
start_values AS (
    SELECT 
        m.month,
        d.src_sup_total_hheat AS start_heat
    FROM monthly_ranges m
    JOIN ods_sc01_ntjt_zhgr_heat_source_inst_data d ON d.src_id = 1
    WHERE d.data_time = (
        SELECT MIN(data_time) 
        FROM ods_sc01_ntjt_zhgr_heat_source_inst_data 
        WHERE src_id = 1 
        AND data_time >= m.start_time
    )
),
end_values AS (
    SELECT 
        m.month,
        d.src_sup_total_hheat AS end_heat
    FROM monthly_ranges m
    JOIN ods_sc01_ntjt_zhgr_heat_source_inst_data d ON d.src_id = 1
    WHERE d.data_time = (
        SELECT MAX(data_time) 
        FROM ods_sc01_ntjt_zhgr_heat_source_inst_data 
        WHERE src_id = 1 
        AND data_time <= m.end_time
    )
)
SELECT 
    s.month,
    (e.end_heat - s.start_heat) AS monthly_total_heat
FROM start_values s
JOIN end_values e ON s.month = e.month
ORDER BY s.month;
