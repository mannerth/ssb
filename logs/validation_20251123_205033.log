    WHERE stn_name LIKE '%豪门又一城%'
),
monthly_data AS (
    SELECT 
        stn_id,
        DATE_FORMAT(data_time, '%Y-%m') AS month,
        MIN(data_time) AS start_time,
        MAX(data_time) AS end_time,
        (MAX(stn1_seco_repl_total_flow) - MIN(stn1_seco_repl_total_flow)) AS water_diff1,
        (MAX(stn2_seco_repl_total_flow) - MIN(stn2_seco_repl_total_flow)) AS water_diff2,
        (MAX(stn3_seco_repl_total_flow) - MIN(stn3_seco_repl_total_flow)) AS water_diff3
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00' 
        AND stn_id = (SELECT stn_id FROM station_info)
    GROUP BY stn_id, DATE_FORMAT(data_time, '%Y-%m')
)
SELECT 
    m.month,
    ((CASE WHEN i.plan_num >= 1 THEN COALESCE(m.water_diff1, 0) ELSE 0 END +
      CASE WHEN i.plan_num >= 2 THEN COALESCE(m.water_diff2, 0) ELSE 0 END +
      CASE WHEN i.plan_num >= 3 THEN COALESCE(m.water_diff3, 0) ELSE 0 END) * 1000 * 120 * 24 / i.heat_area) / 
    (TIMESTAMPDIFF(HOUR, m.start_time, m.end_time) + 1) AS water_specific_consumption 
FROM monthly_data m
JOIN station_info i ON m.stn_id = i.stn_id
ORDER BY water_specific_consumption DESC 
LIMIT 1;
