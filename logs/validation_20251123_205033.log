    SELECT 
        stn_id,
        stn_total_elec AS start_elec,
        data_time AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE stn_id = (SELECT stn_id FROM station_info)
    AND data_time >= '2024-11-15 00:00:00'
    ORDER BY data_time ASC
    LIMIT 1
),
end_period AS (
    SELECT 
        stn_id,
        stn_total_elec AS end_elec,
        data_time AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE stn_id = (SELECT stn_id FROM station_info)
    AND data_time <= '2025-03-15 00:00:00'
    ORDER BY data_time DESC
    LIMIT 1
)
SELECT 
    (e.end_elec - s.start_elec) * 24 * 120 / i.heat_area / (TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1) AS elec_specific_consumption
FROM 
    start_period s
JOIN 
    end_period e ON s.stn_id = e.stn_id
JOIN 
    station_info i ON s.stn_id = i.stn_id;
