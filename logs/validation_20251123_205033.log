        DATE_FORMAT(data_time, '%Y-%m') AS month,
        MAX(data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data 
    WHERE pump_id = '1' 
        AND data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00'
    GROUP BY pump_id, DATE_FORMAT(data_time, '%Y-%m')
),
start_values AS (
    SELECT 
        s.pump_id,
        s.month,
        d.circulate_water_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN monthly_start s ON d.pump_id = s.pump_id AND d.data_time = s.start_time
),
end_values AS (
    SELECT 
        e.pump_id,
        e.month,
        d.circulate_water_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN monthly_end e ON d.pump_id = e.pump_id AND d.data_time = e.end_time
)
SELECT 
    s.pump_id,
    s.month,
    (e.end_heat - s.start_heat) AS monthly_heat_production
FROM start_values s
JOIN end_values e ON s.pump_id = e.pump_id AND s.month = e.month
ORDER BY s.month;
