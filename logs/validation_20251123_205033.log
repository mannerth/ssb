    WHERE stn_name LIKE '%豪门又一城%'
),
month_ranges AS (
    SELECT '2024-11' AS month, '2024-11-15 00:00:00' AS start_time, '2024-11-30 23:59:59' AS end_time
    UNION ALL SELECT '2024-12', '2024-12-01 00:00:00', '2024-12-31 23:59:59'
    UNION ALL SELECT '2025-01', '2025-01-01 00:00:00', '2025-01-31 23:59:59'
    UNION ALL SELECT '2025-02', '2025-02-01 00:00:00', '2025-02-28 23:59:59'
    UNION ALL SELECT '2025-03', '2025-03-01 00:00:00', '2025-03-15 00:00:00'
),
start_data AS (
    SELECT
        m.month,
        s.stn_id,
        MIN(d.data_time) AS start_time
    FROM month_ranges m
    CROSS JOIN station_info s
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON d.stn_id = s.stn_id
    WHERE d.data_time BETWEEN m.start_time AND m.end_time
    GROUP BY m.month, s.stn_id
),
end_data AS (
    SELECT
        m.month,
        s.stn_id,
        MAX(d.data_time) AS end_time
    FROM month_ranges m
    CROSS JOIN station_info s
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON d.stn_id = s.stn_id
    WHERE d.data_time BETWEEN m.start_time AND m.end_time
    GROUP BY m.month, s.stn_id
),
start_values AS (
    SELECT
        sd.month,
        sd.stn_id,
        sd.start_time,
        d.stn_total_elec AS start_elec
    FROM start_data sd
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON sd.stn_id = d.stn_id AND sd.start_time = d.data_time
),
end_values AS (
    SELECT
        ed.month,
        ed.stn_id,
        ed.end_time,
        d.stn_total_elec AS end_elec
    FROM end_data ed
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON ed.stn_id = d.stn_id AND ed.end_time = d.data_time
)
SELECT
    s.month,
    (e.end_elec - s.start_elec) * 24 * 120 / i.heat_area / (TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1) AS elec_specific_consumption
FROM start_values s
JOIN end_values e ON s.stn_id = e.stn_id AND s.month = e.month
JOIN station_info i ON s.stn_id = i.stn_id
ORDER BY elec_specific_consumption DESC 
LIMIT 1;
