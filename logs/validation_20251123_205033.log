2025-11-23 21:58:29,934 - src.workflow - INFO - workflow.py:125 - 采纳SQL: SELECT stn_id, heat_area, plan_num 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE belong_unit LIKE '%商河%'
),
start_period AS (
    SELECT stn_id, MIN(data_time) AS start_time 
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time >= '2024-11-15 00:00:00' 
    GROUP BY stn_id
),
end_period AS (
    SELECT stn_id, MAX(data_time) AS end_time 
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time <= '2025-03-15 00:00:00' 
    GROUP BY stn_id
),
start_heat AS (
    SELECT d.stn_id, d.stn_prim_total_hheat AS start_heat 
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN start_period s ON d.stn_id = s.stn_id AND d.data_time = s.start_time
),
end_heat AS (
    SELECT d.stn_id, d.stn_prim_total_hheat AS end_heat 
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN end_period e ON d.stn_id = e.stn_id AND d.data_time = e.end_time
),
daily_avg_temp AS (
    SELECT DATE(data_time) AS date, AVG(temp) AS avg_temp 
    FROM ods_sc01_ntjt_zhgr_heat_weather_info_log 
    WHERE data_time >= '2024-11-15 00:00:00' AND data_time < '2025-03-15 00:00:00' 
    GROUP BY DATE(data_time)
),
degree_days AS (
    SELECT SUM(GREATEST(22 - avg_temp, 0)) AS HDD_season 
    FROM daily_avg_temp
),
heat_specific_consumption AS (
    SELECT 
        s.stn_id, 
        (e.end_heat - s.start_heat) / i.heat_area * 24 * 120 / (TIMESTAMPDIFF(HOUR, '2024-11-15 00:00:00', '2025-03-15 00:00:00') + 1) AS heat_per_area
    FROM start_heat s
    JOIN end_heat e ON s.stn_id = e.stn_id
    JOIN station_info i ON s.stn_id = i.stn_id
    WHERE e.end_heat IS NOT NULL AND s.start_heat IS NOT NULL AND i.heat_area > 0
)
SELECT 
    h.stn_id, 
    h.heat_per_area / d.HDD_season AS heat_per_area_per_degree_day 
FROM heat_specific_consumption h, degree_days d 
ORDER BY heat_per_area_per_degree_day DESC 
LIMIT 5;
