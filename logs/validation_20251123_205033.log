        MIN(d.data_time) AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    WHERE d.data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00'
    GROUP BY d.pump_id, DATE_FORMAT(d.data_time, '%Y-%m')
),

pump_end_period AS (
    SELECT 
        d.pump_id,
        DATE_FORMAT(d.data_time, '%Y-%m') AS month,
        MAX(d.data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    WHERE d.data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00'
    GROUP BY d.pump_id, DATE_FORMAT(d.data_time, '%Y-%m')
),

pump_start_values AS (
    SELECT 
        s.pump_id,
        s.month,
        d.heatpump_total_gas AS start_data
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN pump_start_period s ON d.pump_id = s.pump_id AND d.data_time = s.start_time
),

pump_end_values AS (
    SELECT 
        e.pump_id,
        e.month,
        d.heatpump_total_gas AS end_data
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN pump_end_period e ON d.pump_id = e.pump_id AND d.data_time = e.end_time
),

month_pump_gas AS (
    SELECT 
        s.pump_id,
        s.month,
        COALESCE(COALESCE(e.end_data, 0) - COALESCE(s.start_data, 0), 0) AS monthly_total_data
    FROM pump_start_values s
    JOIN pump_end_values e ON s.pump_id = e.pump_id AND s.month = e.month
),

month_boiler_gas_usage AS (
    SELECT 
        month,
        SUM(monthly_total_data) AS month_total_boiler_gas
    FROM month_boiler_gas
    GROUP BY month
),

month_pump_gas_usage AS (
    SELECT 
        month,
        SUM(monthly_total_data) AS month_total_pump_gas
    FROM month_pump_gas
    GROUP BY month
),

all_months AS (
    SELECT DISTINCT month FROM month_boiler_gas_usage
    UNION
    SELECT DISTINCT month FROM month_pump_gas_usage
)

SELECT
    m.month,
    COALESCE(b.month_total_boiler_gas, 0) + COALESCE(p.month_total_pump_gas, 0) AS total_gas_usage
FROM all_months m
LEFT JOIN month_boiler_gas_usage b ON m.month = b.month
LEFT JOIN month_pump_gas_usage p ON m.month = p.month
ORDER BY m.month;
