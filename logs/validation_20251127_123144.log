2025-11-27 15:17:31,648 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH start_period AS (
    SELECT 
        src_id, 
        DATE_FORMAT(data_time, '%Y-%m') AS month,
        MIN(data_time) AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data 
    WHERE src_id IN (1, 2) 
        AND data_time >= '2024-11-15 00:00:00' 
        AND data_time <= '2025-03-15 00:00:00'
    GROUP BY src_id, DATE_FORMAT(data_time, '%Y-%m')
),
end_period AS (
    SELECT 
        src_id, 
        DATE_FORMAT(data_time, '%Y-%m') AS month,
        MAX(data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data 
    WHERE src_id IN (1, 2) 
        AND data_time >= '2024-11-15 00:00:00' 
        AND data_time <= '2025-03-15 00:00:00'
    GROUP BY src_id, DATE_FORMAT(data_time, '%Y-%m')
),
start_values AS (
    SELECT 
        s.src_id, 
        s.month,
        d.src_sup_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data d 
    JOIN start_period s ON d.src_id = s.src_id AND d.data_time = s.start_time
),
end_values AS (
    SELECT 
        e.src_id, 
        e.month,
        d.src_sup_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data d 
    JOIN end_period e ON d.src_id = e.src_id AND d.data_time = e.end_time
)
SELECT 
    CASE 
        WHEN s.src_id = 1 THEN '商河恒泰热源厂'
        WHEN s.src_id = 2 THEN '玉泉生物质电厂'
    END AS src_name,
    s.month,
    GREATEST(e.end_heat - s.start_heat, 0) AS monthly_total_heat
FROM start_values s 
JOIN end_values e ON s.src_id = e.src_id AND s.month = e.month
ORDER BY s.src_id, s.month;
