2025-11-27 14:06:57,063 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH station_info AS (
    SELECT stn_id, stn_name, heat_area, plan_num 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE heat_area > 0
),
start_period AS (
    SELECT 
        d.stn_id,
        d.stn1_seco_repl_total_flow AS start_val1,
        d.stn2_seco_repl_total_flow AS start_val2,
        d.stn3_seco_repl_total_flow AS start_val3
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    WHERE d.data_time = (
        SELECT MIN(data_time) 
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
        WHERE stn_id = d.stn_id AND data_time >= '2024-11-15 00:00:00'
    )
),
end_period AS (
    SELECT 
        d.stn_id,
        d.stn1_seco_repl_total_flow AS end_val1,
        d.stn2_seco_repl_total_flow AS end_val2,
        d.stn3_seco_repl_total_flow AS end_val3
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    WHERE d.data_time = (
        SELECT MAX(data_time) 
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
        WHERE stn_id = d.stn_id AND data_time <= '2025-03-15 00:00:00'
    )
),
water_consumption AS (
    SELECT 
        i.stn_id,
        i.stn_name,
        ((COALESCE(e.end_val1, 0) - COALESCE(s.start_val1, 0) +
          CASE WHEN i.plan_num >= 2 THEN COALESCE(e.end_val2, 0) - COALESCE(s.start_val2, 0) ELSE 0 END +
          CASE WHEN i.plan_num >= 3 THEN COALESCE(e.end_val3, 0) - COALESCE(s.start_val3, 0) ELSE 0 END) * 
         1000 * 120 * 24 / NULLIF(i.heat_area, 0)) / 
        (TIMESTAMPDIFF(HOUR, '2024-11-15 00:00:00', '2025-03-15 00:00:00') + 1) AS water_specific_consumption
    FROM station_info i
    LEFT JOIN start_period s ON i.stn_id = s.stn_id
    LEFT JOIN end_period e ON i.stn_id = e.stn_id
    WHERE (COALESCE(e.end_val1, 0) - COALESCE(s.start_val1, 0) +
           CASE WHEN i.plan_num >= 2 THEN COALESCE(e.end_val2, 0) - COALESCE(s.start_val2, 0) ELSE 0 END +
           CASE WHEN i.plan_num >= 3 THEN COALESCE(e.end_val3, 0) - COALESCE(s.start_val3, 0) ELSE 0 END) > 0
)
SELECT stn_id, stn_name, water_specific_consumption
FROM water_consumption
WHERE water_specific_consumption IS NOT NULL
ORDER BY water_specific_consumption DESC
LIMIT 10;
