2025-11-27 12:35:23,331 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH monthly_periods AS (
    SELECT '2024-11' AS month, '2024-11-15 00:00:00' AS start_time, '2024-11-30 23:59:59' AS end_time
    UNION ALL SELECT '2024-12', '2024-12-01 00:00:00', '2024-12-31 23:59:59'
    UNION ALL SELECT '2025-01', '2025-01-01 00:00:00', '2025-01-31 23:59:59'
    UNION ALL SELECT '2025-02', '2025-02-01 00:00:00', '2025-02-28 23:59:59'
    UNION ALL SELECT '2025-03', '2025-03-01 00:00:00', '2025-03-15 00:00:00'
),
station_info AS (
    SELECT stn_id, stn_name, heat_area 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE belong_unit LIKE '%商河%'
),
start_data AS (
    SELECT 
        d.stn_id,
        m.month,
        m.start_time,
        d.stn_total_elec AS start_elec
    FROM monthly_periods m
    CROSS JOIN station_info i
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON i.stn_id = d.stn_id
    WHERE d.data_time = (
        SELECT MIN(data_time) 
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
        WHERE stn_id = i.stn_id AND data_time >= m.start_time
    )
),
end_data AS (
    SELECT 
        d.stn_id,
        m.month,
        m.end_time,
        d.stn_total_elec AS end_elec
    FROM monthly_periods m
    CROSS JOIN station_info i
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON i.stn_id = d.stn_id
    WHERE d.data_time = (
        SELECT MAX(data_time) 
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
        WHERE stn_id = i.stn_id AND data_time <= m.end_time
    )
),
electricity_consumption AS (
    SELECT 
        s.stn_id,
        i.stn_name,
        s.month,
        (e.end_elec - s.start_elec) * 24 * 120 / i.heat_area / (TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1) AS elec_specific_consumption
    FROM start_data s
    JOIN end_data e ON s.stn_id = e.stn_id AND s.month = e.month
    JOIN station_info i ON s.stn_id = i.stn_id
    WHERE e.end_elec > s.start_elec
),
ranked_stations AS (
    SELECT 
        stn_id,
        stn_name,
        month,
        elec_specific_consumption,
        ROW_NUMBER() OVER (PARTITION BY month ORDER BY elec_specific_consumption DESC) as rank_num
    FROM electricity_consumption
)
SELECT 
    stn_id,
    stn_name,
    month,
    elec_specific_consumption
FROM ranked_stations
WHERE rank_num <= 5
ORDER BY month, rank_num;
