        s.month,
        COALESCE(e.end_data - s.start_data, 0) AS monthly_total_data
    FROM pump_start_values s 
    JOIN pump_end_values e ON s.pump_id = e.pump_id AND s.month = e.month
),
month_boiler_gas_usage AS (
    SELECT 
        month, 
        SUM(monthly_total_data) AS month_total_boiler_gas 
    FROM month_boiler_gas 
    GROUP BY month
),
month_pump_gas_usage AS (
    SELECT 
        month, 
        SUM(monthly_total_data) AS month_total_pump_gas 
    FROM month_pump_gas 
    GROUP BY month
)
SELECT
    COALESCE(b.month, p.month) AS month,
    (COALESCE(b.month_total_boiler_gas, 0) + COALESCE(p.month_total_pump_gas, 0)) AS total_gas_usage
FROM
    month_boiler_gas_usage b 
    FULL OUTER JOIN month_pump_gas_usage p ON b.month = p.month
ORDER BY month;
