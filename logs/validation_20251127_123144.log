    SELECT 
        s.pump_id,
        s.month,
        d.circulate_water_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN start_period s ON d.pump_id = s.pump_id AND d.data_time = s.start_time
),
end_values AS (
    SELECT 
        e.pump_id,
        e.month,
        d.circulate_water_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN end_period e ON d.pump_id = e.pump_id AND d.data_time = e.end_time
)
SELECT 
    s.pump_id,
    s.month,
    (e.end_heat - s.start_heat) AS monthly_total_heat
FROM start_values s
JOIN end_values e ON s.pump_id = e.pump_id AND s.month = e.month
ORDER BY s.month;
