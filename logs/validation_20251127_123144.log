2025-11-27 14:23:13,640 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH source_start AS (
    SELECT src_id, src_sup_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
    WHERE src_id IN (1, 2)
    AND data_time = (
        SELECT MIN(data_time)
        FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
        WHERE data_time >= '2025-01-01 00:00:00'
        AND src_id IN (1, 2)
    )
),
source_end AS (
    SELECT src_id, src_sup_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
    WHERE src_id IN (1, 2)
    AND data_time = (
        SELECT MAX(data_time)
        FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
        WHERE data_time <= '2025-01-01 23:59:59'
        AND src_id IN (1, 2)
    )
),
station_start AS (
    SELECT stn_id, stn_prim_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data
    WHERE data_time = (
        SELECT MIN(data_time)
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data
        WHERE data_time >= '2025-01-01 00:00:00'
    )
    AND stn_id IN (SELECT stn_id FROM ods_sc01_ntjt_zhgr_heat_station_info)
),
station_end AS (
    SELECT stn_id, stn_prim_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data
    WHERE data_time = (
        SELECT MAX(data_time)
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data
        WHERE data_time <= '2025-01-01 23:59:59'
    )
    AND stn_id IN (SELECT stn_id FROM ods_sc01_ntjt_zhgr_heat_station_info)
),
source_total AS (
    SELECT SUM(e.end_heat - s.start_heat) AS total_source_heat
    FROM source_start s
    JOIN source_end e ON s.src_id = e.src_id
),
station_total AS (
    SELECT SUM(e.end_heat - s.start_heat) AS total_station_heat
    FROM station_start s
    JOIN station_end e ON s.stn_id = e.stn_id
)
SELECT 
    ((s.total_source_heat - t.total_station_heat) / s.total_source_heat) * 100 AS net_loss_rate
FROM source_total s, station_total t;
