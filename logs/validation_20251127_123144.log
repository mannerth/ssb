2025-11-27 13:53:30,845 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH station_info AS (
    SELECT stn_id, stn_name, heat_area 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE heat_area > 0
),
start_period AS (
    SELECT 
        stn_id,
        MIN(data_time) AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time >= '2024-11-15 00:00:00'
    GROUP BY stn_id
),
end_period AS (
    SELECT 
        stn_id,
        MAX(data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time <= '2025-03-15 00:00:00'
    GROUP BY stn_id
),
start_heat AS (
    SELECT 
        d.stn_id,
        d.stn_prim_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN start_period s ON d.stn_id = s.stn_id AND d.data_time = s.start_time
),
end_heat AS (
    SELECT 
        d.stn_id,
        d.stn_prim_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN end_period e ON d.stn_id = e.stn_id AND d.data_time = e.end_time
),
heat_specific_consumption AS (
    SELECT 
        s.stn_id,
        i.stn_name,
        (e.end_heat - s.start_heat) / i.heat_area * 24 * 120 / (TIMESTAMPDIFF(HOUR, sp.start_time, ep.end_time) + 1) AS heat_specific_consumption
    FROM start_heat s
    JOIN end_heat e ON s.stn_id = e.stn_id
    JOIN station_info i ON s.stn_id = i.stn_id
    JOIN start_period sp ON s.stn_id = sp.stn_id
    JOIN end_period ep ON s.stn_id = ep.stn_id
    WHERE e.end_heat > s.start_heat
)
SELECT 
    stn_name,
    heat_specific_consumption
FROM heat_specific_consumption
ORDER BY heat_specific_consumption DESC
LIMIT 10;
