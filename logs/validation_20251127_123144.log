2025-11-27 14:11:32,530 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH start_period AS (
    SELECT 
        src_id,
        MIN(data_time) AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
    WHERE src_id IN (1, 2)
    AND data_time >= '2024-11-15 00:00:00'
    GROUP BY src_id
),
end_period AS (
    SELECT 
        src_id,
        MAX(data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
    WHERE src_id IN (1, 2)
    AND data_time <= '2025-03-15 00:00:00'
    GROUP BY src_id
),
start_values AS (
    SELECT 
        d.src_id,
        d.src_sup_total_hheat AS start_heat,
        s.start_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data d
    JOIN start_period s ON d.src_id = s.src_id AND d.data_time = s.start_time
),
end_values AS (
    SELECT 
        d.src_id,
        d.src_sup_total_hheat AS end_heat,
        e.end_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data d
    JOIN end_period e ON d.src_id = e.src_id AND d.data_time = e.end_time
),
total_heat_area AS (
    SELECT SUM(heat_area) AS total_heat_area
    FROM ods_sc01_ntjt_zhgr_heat_station_info
),
heat_diff AS (
    SELECT 
        SUM(e.end_heat - s.start_heat) AS total_heat,
        SUM(TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1) AS total_hours
    FROM start_values s
    JOIN end_values e ON s.src_id = e.src_id
)
SELECT 
    (h.total_heat / a.total_heat_area) * 24 * 120 / h.total_hours AS avg_heat_consumption
FROM heat_diff h, total_heat_area a;
