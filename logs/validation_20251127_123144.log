2025-11-27 14:20:03,606 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH daily_heat_data AS (
    SELECT 
        DATE(data_time) AS heat_date,
        src_id,
        MIN(data_time) AS start_time,
        MAX(data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_source_inst_data
    WHERE src_id IN (1, 2)
        AND data_time >= '2024-11-15 00:00:00' 
        AND data_time < '2025-03-15 00:00:00'
    GROUP BY DATE(data_time), src_id
),
start_heat_values AS (
    SELECT 
        d.heat_date,
        d.src_id,
        s.src_sup_total_hheat AS start_heat,
        d.start_time
    FROM daily_heat_data d
    JOIN ods_sc01_ntjt_zhgr_heat_source_inst_data s 
        ON d.src_id = s.src_id AND d.start_time = s.data_time
),
end_heat_values AS (
    SELECT 
        d.heat_date,
        d.src_id,
        s.src_sup_total_hheat AS end_heat,
        d.end_time
    FROM daily_heat_data d
    JOIN ods_sc01_ntjt_zhgr_heat_source_inst_data s 
        ON d.src_id = s.src_id AND d.end_time = s.data_time
),
daily_heat_diff AS (
    SELECT 
        s.heat_date,
        SUM(e.end_heat - s.start_heat) AS daily_heat,
        TIMESTAMPDIFF(HOUR, MIN(s.start_time), MAX(e.end_time)) + 1 AS hours_diff
    FROM start_heat_values s
    JOIN end_heat_values e ON s.heat_date = e.heat_date AND s.src_id = e.src_id
    GROUP BY s.heat_date
),
total_area AS (
    SELECT SUM(heat_area) AS total_heat_area
    FROM ods_sc01_ntjt_zhgr_heat_station_info
)
SELECT 
    d.heat_date,
    (d.daily_heat / ta.total_heat_area) * 24 * 120 / d.hours_diff AS daily_heat_consumption
FROM daily_heat_diff d
CROSS JOIN total_area ta
ORDER BY daily_heat_consumption DESC
LIMIT 1;
