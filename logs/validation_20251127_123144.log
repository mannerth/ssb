2025-11-27 13:32:54,069 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH station_info AS (
    SELECT stn_id, heat_area 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE stn_name LIKE '%豪门又一城%'
),
daily_electricity AS (
    SELECT 
        DATE(data_time) as day_date,
        MAX(stn_total_elec) - MIN(stn_total_elec) as daily_elec_consumption,
        (SELECT heat_area FROM station_info) as heat_area,
        TIMESTAMPDIFF(HOUR, MIN(data_time), MAX(data_time)) + 1 as hours_diff
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE stn_id = (SELECT stn_id FROM station_info)
        AND data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00'
    GROUP BY DATE(data_time)
    HAVING daily_elec_consumption > 0
)
SELECT 
    day_date,
    (daily_elec_consumption * 24 * 120 / heat_area / hours_diff) as electricity_specific_consumption
FROM daily_electricity
ORDER BY electricity_specific_consumption DESC
LIMIT 1;
