        d.stn_id,
        MIN(d.data_time) AS start_time,
        MAX(CASE WHEN d.data_time = MIN(d.data_time) OVER (PARTITION BY d.stn_id, m.month) THEN d.stn1_seco_repl_total_flow END) AS start_val1,
        MAX(CASE WHEN d.data_time = MIN(d.data_time) OVER (PARTITION BY d.stn_id, m.month) THEN d.stn2_seco_repl_total_flow END) AS start_val2,
        MAX(CASE WHEN d.data_time = MIN(d.data_time) OVER (PARTITION BY d.stn_id, m.month) THEN d.stn3_seco_repl_total_flow END) AS start_val3
    FROM month_ranges m
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON d.data_time >= m.start_time AND d.data_time <= m.end_time
    WHERE d.stn_id = (SELECT stn_id FROM station_info)
    GROUP BY m.month, d.stn_id
),
end_data AS (
    SELECT
        m.month,
        d.stn_id,
        MAX(d.data_time) AS end_time,
        MAX(CASE WHEN d.data_time = MAX(d.data_time) OVER (PARTITION BY d.stn_id, m.month) THEN d.stn1_seco_repl_total_flow END) AS end_val1,
        MAX(CASE WHEN d.data_time = MAX(d.data_time) OVER (PARTITION BY d.stn_id, m.month) THEN d.stn2_seco_repl_total_flow END) AS end_val2,
        MAX(CASE WHEN d.data_time = MAX(d.data_time) OVER (PARTITION BY d.stn_id, m.month) THEN d.stn3_seco_repl_total_flow END) AS end_val3
    FROM month_ranges m
    JOIN ods_sc01_ntjt_zhgr_heat_station_inst_data d ON d.data_time >= m.start_time AND d.data_time <= m.end_time
    WHERE d.stn_id = (SELECT stn_id FROM station_info)
    GROUP BY m.month, d.stn_id
),
monthly_water_consumption AS (
    SELECT 
        s.month,
        s.stn_id,
        s.start_time,
        e.end_time,
        ((COALESCE(e.end_val1, 0) - COALESCE(s.start_val1, 0)) +
         (CASE WHEN i.plan_num >= 2 THEN COALESCE(e.end_val2, 0) - COALESCE(s.start_val2, 0) ELSE 0 END) +
         (CASE WHEN i.plan_num >= 3 THEN COALESCE(e.end_val3, 0) - COALESCE(s.start_val3, 0) ELSE 0 END)) AS total_water_consumption,
        TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1 AS hours_in_month
    FROM start_data s
    JOIN end_data e ON s.month = e.month AND s.stn_id = e.stn_id
    JOIN station_info i ON s.stn_id = i.stn_id
)
SELECT 
    month,
    (total_water_consumption * 1000 * 120 * 24 / i.heat_area / hours_in_month) AS water_specific_consumption
FROM monthly_water_consumption m
JOIN station_info i ON m.stn_id = i.stn_id
ORDER BY water_specific_consumption DESC
LIMIT 1;
