    ORDER BY data_time ASC
    LIMIT 1
),
end_period AS (
    SELECT stn_id, stn_total_elec AS end_elec, data_time AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE stn_id = (SELECT stn_id FROM station_info) 
