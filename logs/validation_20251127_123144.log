2025-11-27 14:34:02,252 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH pump_start_period AS (
    SELECT 
        d.pump_id,
        DATE_FORMAT(d.data_time, '%Y-%m') AS month,
        MIN(d.data_time) AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN ods_sc01_ntjt_zhgr_heat_source_info s ON s.src_name LIKE '%恒泰热源%'
    WHERE d.data_time >= '2024-11-15 00:00:00' 
      AND d.data_time <= '2025-03-15 00:00:00'
    GROUP BY d.pump_id, DATE_FORMAT(d.data_time, '%Y-%m')
),
pump_end_period AS (
    SELECT 
        d.pump_id,
        DATE_FORMAT(d.data_time, '%Y-%m') AS month,
        MAX(d.data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN ods_sc01_ntjt_zhgr_heat_source_info s ON s.src_name LIKE '%恒泰热源%'
    WHERE d.data_time >= '2024-11-15 00:00:00' 
      AND d.data_time <= '2025-03-15 00:00:00'
    GROUP BY d.pump_id, DATE_FORMAT(d.data_time, '%Y-%m')
),
pump_start_values AS (
    SELECT 
        s.pump_id,
        s.month,
        d.heatpump_total_gas AS start_gas
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN pump_start_period s ON d.pump_id = s.pump_id AND d.data_time = s.start_time
),
pump_end_values AS (
    SELECT 
        e.pump_id,
        e.month,
        d.heatpump_total_gas AS end_gas
    FROM ods_sc01_ntjt_zhgr_heat_heatpump_inst_data d
    JOIN pump_end_period e ON d.pump_id = e.pump_id AND d.data_time = e.end_time
)
SELECT 
    s.pump_id,
    s.month,
    (e.end_gas - s.start_gas) AS monthly_gas_usage
FROM pump_start_values s
JOIN pump_end_values e ON s.pump_id = e.pump_id AND s.month = e.month
ORDER BY s.pump_id, s.month;
