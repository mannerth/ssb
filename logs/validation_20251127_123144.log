2025-11-27 13:59:08,244 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH station_info AS (
    SELECT stn_id, stn_name, heat_area 
    FROM ods_sc01_ntjt_zhgr_heat_station_info 
    WHERE build_type = '0'
),
start_period AS (
    SELECT 
        stn_id,
        MIN(data_time) AS start_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time >= '2024-11-15 00:00:00'
    GROUP BY stn_id
),
end_period AS (
    SELECT 
        stn_id,
        MAX(data_time) AS end_time
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data 
    WHERE data_time <= '2025-03-15 00:00:00'
    GROUP BY stn_id
),
start_heat AS (
    SELECT
        d.stn_id,
        d.stn_prim_total_hheat AS start_heat
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN start_period s ON d.stn_id = s.stn_id AND d.data_time = s.start_time
),
end_heat AS (
    SELECT
        d.stn_id,
        d.stn_prim_total_hheat AS end_heat
    FROM ods_sc01_ntjt_zhgr_heat_station_inst_data d
    JOIN end_period e ON d.stn_id = e.stn_id AND d.data_time = e.end_time
),
heat_consumption AS (
    SELECT 
        i.stn_id,
        i.stn_name,
        i.heat_area,
        (e.end_heat - s.start_heat) / i.heat_area * 24 * 120 / (TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1) AS heat_specific_consumption
    FROM station_info i
    JOIN start_heat s ON i.stn_id = s.stn_id
    JOIN end_heat e ON i.stn_id = e.stn_id
    WHERE e.end_heat > s.start_heat AND i.heat_area > 0
),
ranked_stations AS (
    SELECT 
        stn_name,
        heat_specific_consumption,
        heat_area,
        ROW_NUMBER() OVER (ORDER BY heat_specific_consumption DESC) AS rank_position
    FROM heat_consumption
)
SELECT stn_name, heat_specific_consumption, heat_area, rank_position
FROM ranked_stations
WHERE rank_position <= 10
ORDER BY heat_specific_consumption DESC;
