2025-11-27 15:13:55,655 - src.workflow - INFO - workflow.py:145 - 采纳SQL: WITH monthly_ranges AS (
    SELECT 
        b.blr_id,
        DATE_FORMAT(b.data_time, '%Y-%m') AS month,
        MIN(b.data_time) AS month_start,
        MAX(b.data_time) AS month_end
    FROM ods_sc01_ntjt_zhgr_heat_boiler_inst_data b
    JOIN ods_sc01_ntjt_zhgr_heat_source_info s ON b.src_id = s.src_id
    WHERE s.src_name LIKE '%恒泰热源%'
    AND b.data_time BETWEEN '2024-11-15 00:00:00' AND '2025-03-15 00:00:00'
    GROUP BY b.blr_id, DATE_FORMAT(b.data_time, '%Y-%m')
),
start_gas AS (
    SELECT 
        m.blr_id,
        m.month,
        d.blr_gas_total_hflow AS start_gas_value
    FROM monthly_ranges m
    JOIN ods_sc01_ntjt_zhgr_heat_boiler_inst_data d 
        ON m.blr_id = d.blr_id AND m.month_start = d.data_time
),
end_gas AS (
    SELECT 
        m.blr_id,
        m.month,
        d.blr_gas_total_hflow AS end_gas_value
    FROM monthly_ranges m
    JOIN ods_sc01_ntjt_zhgr_heat_boiler_inst_data d 
        ON m.blr_id = d.blr_id AND m.month_end = d.data_time
)
SELECT 
    s.blr_id,
    s.month,
    (e.end_gas_value - s.start_gas_value) AS monthly_gas_consumption
FROM start_gas s
JOIN end_gas e ON s.blr_id = e.blr_id AND s.month = e.month
ORDER BY s.blr_id, s.month;
