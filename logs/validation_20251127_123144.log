    ) t
    WHERE rn = 1
),
end_period AS (
    SELECT 
        stn_id,
        stn_total_elec AS end_elec,
        data_time AS end_time
    FROM (
        SELECT 
            stn_id,
            stn_total_elec,
            data_time,
            ROW_NUMBER() OVER (PARTITION BY stn_id ORDER BY data_time DESC) AS rn
        FROM ods_sc01_ntjt_zhgr_heat_station_inst_data
        WHERE data_time >= '2024-11-15 00:00:00' AND data_time <= '2025-03-15 00:00:00'
    ) t
    WHERE rn = 1
),
electricity_consumption AS (
    SELECT 
        s.stn_id,
        i.stn_name,
        (e.end_elec - s.start_elec) * 24 * 120 / i.heat_area / 
        (TIMESTAMPDIFF(HOUR, s.start_time, e.end_time) + 1) AS elec_specific_consumption
    FROM start_period s
    JOIN end_period e ON s.stn_id = e.stn_id
    JOIN ods_sc01_ntjt_zhgr_heat_station_info i ON s.stn_id = i.stn_id
    WHERE i.heat_area > 0
)
SELECT 
    stn_id,
    stn_name,
    elec_specific_consumption
FROM electricity_consumption
ORDER BY elec_specific_consumption DESC
LIMIT 5;
